:root {
  --bg: #f7f4ef;
  --panel: #fffdf9;
  --primary: #1f2937;
  --primary-soft: #3c4b5b;
  --accent: #c9a46a;
  --accent-soft: #f5e7cf;
  --text: #221d1a;
  --muted: #5d5954;
  --light: #f1efe9;
  --border: rgba(31, 41, 55, 0.12);
  --shadow: 0 20px 50px rgba(16, 15, 12, 0.08);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
}

a {
  text-decoration: none;
  color: inherit;
}

button,
input {
  font: inherit;
}

img {
  display: block;
  width: 100%;
}

#root {
  min-height: 100vh;
}

.page-shell {
  width: 100%;
}

.container {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(12px);
  background: rgba(247, 244, 239, 0.82);
  border-bottom: 1px solid var(--border);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84px;
  gap: 24px;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), var(--primary-soft));
  color: white;
  display: grid;
  place-items: center;
  font-weight: 700;
  font-size: 1.4rem;
}

.brand-name {
  margin: 0;
  font-weight: 700;
  letter-spacing: 0.04em;
  font-size: 1.1rem;
}

.brand-subtitle {
  color: var(--muted);
  font-size: 0.76rem;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
  color: var(--muted);
  font-weight: 500;
}

.primary-btn,
.secondary-btn,
.filter-btn {
  border: none;
  border-radius: 999px;
  cursor: pointer;
  transition: 0.2s ease;
}

.primary-btn {
  background: var(--primary);
  color: #fff;
  padding: 0.9rem 1.6rem;
  font-weight: 600;
  box-shadow: var(--shadow);
}

.primary-btn:hover,
.secondary-btn:hover,
.filter-btn:hover {
  transform: translateY(-1px);
}

.small-btn {
  padding: 0.7rem 1rem;
}

.secondary-btn {
  background: transparent;
  color: var(--primary);
  border: 1px solid var(--border);
  padding: 0.9rem 1.4rem;
  font-weight: 600;
}

.hero {
  padding: 72px 0 40px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 52px;
}

.eyebrow {
  margin: 0 0 10px;
  color: var(--accent);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 0.74rem;
  font-weight: 700;
}

h1,
h2,
h3 {
  margin: 0;
  font-family: 'Cormorant Garamond', serif;
  line-height: 1;
}

h1 {
  font-size: clamp(3.5rem, 6vw, 5.3rem);
  letter-spacing: -0.04em;
  max-width: 550px;
}

h2 {
  font-size: clamp(2.3rem, 4vw, 3.2rem);
  letter-spacing: -0.03em;
}

.lead {
  color: var(--muted);
  font-size: 1.08rem;
  line-height: 1.8;
  max-width: 600px;
  margin: 18px 0 0;
}

.hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
  margin-top: 28px;
}

.stats-grid {
  margin-top: 34px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.stat-box {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 18px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-box strong {
  font-size: 1.5rem;
  letter-spacing: -0.04em;
}

.stat-box span {
  font-size: 0.74rem;
  color: var(--muted);
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.image-card {
  position: relative;
  border-radius: 32px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.large-card {
  width: min(100%, 500px);
}

.large-card img {
  height: 660px;
  object-fit: cover;
}

.floating-tag {
  position: absolute;
  bottom: 26px;
  left: 26px;
  background: rgba(255, 255, 255, 0.86);
  color: var(--primary);
  padding: 0.7rem 1rem;
  border-radius: 999px;
  font-weight: 700;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
}

.catalog,
.about,
.reviews,
.admin-panel {
  padding: 42px 0 22px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 28px;
}

.center {
  justify-content: center;
  text-align: center;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: end;
  margin-bottom: 28px;
  flex-wrap: wrap;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.filter-btn {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--border);
  color: var(--muted);
  padding: 0.65rem 1rem;
  font-weight: 600;
}

.filter-btn.active {
  background: var(--primary);
  color: white;
}

.search-box {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: min(100%, 300px);
  color: var(--muted);
  font-size: 0.85rem;
}

.search-box input {
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.7);
  padding: 0.9rem 0.95rem;
  outline: none;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
}

.product-card {
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--border);
  border-radius: 24px;
  overflow: hidden;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
}

.product-image-wrap {
  position: relative;
  height: 270px;
}

.product-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-tag {
  position: absolute;
  top: 14px;
  left: 14px;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 999px;
  padding: 0.5rem 0.7rem;
  font-size: 0.7rem;
  font-weight: 700;
}

.product-body {
  padding: 18px 16px 20px;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--muted);
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.product-body h3 {
  font-size: 2rem;
  margin-top: 12px;
}

.product-body p {
  color: var(--muted);
  line-height: 1.6;
  margin: 10px 0 16px;
}

.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.color-pill {
  background: var(--light);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 0.42rem 0.6rem;
  font-size: 0.7rem;
  color: var(--primary-soft);
}

.full-btn {
  width: 100%;
}

.empty-state {
  padding: 30px;
  text-align: center;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 18px;
  border: 1px solid var(--border);
  color: var(--muted);
}

.about-grid {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  gap: 40px;
  align-items: center;
}

.about-visual img {
  max-height: 500px;
  object-fit: cover;
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.feature-list {
  list-style: none;
  padding: 0;
  margin: 24px 0 0;
  display: grid;
  gap: 16px;
  color: var(--muted);
  line-height: 1.7;
}

.feature-list li {
  position: relative;
  padding-left: 26px;
}

.feature-list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--accent);
  font-weight: 700;
}

.review-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.review-card {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 22px 20px;
}

.stars {
  color: #f7b500;
  font-size: 1.1rem;
  letter-spacing: 0.2em;
  margin-bottom: 16px;
}

.review-card p {
  color: var(--muted);
  line-height: 1.8;
  margin: 0 0 18px;
}

.review-card strong {
  font-size: 1rem;
}

.admin-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}

.metric-card {
  background: linear-gradient(135deg, #1b1f26, #2d3947);
  color: white;
  border-radius: 22px;
  padding: 24px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-shadow: var(--shadow);
}

.metric-card span {
  opacity: 0.8;
}

.metric-card strong {
  font-size: 2.2rem;
  letter-spacing: -0.05em;
}

.metric-card small {
  opacity: 0.8;
}

.inventory-table-wrap {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid var(--border);
  border-radius: 20px;
  overflow: hidden;
}

.inventory-table {
  width: 100%;
  border-collapse: collapse;
}

.inventory-table th,
.inventory-table td {
  padding: 16px 20px;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

.inventory-table th {
  background: rgba(17, 24, 39, 0.04);
  color: var(--primary-soft);
  font-weight: 700;
}

.status {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 0.5rem 0.7rem;
  font-size: 0.72rem;
  font-weight: 700;
}

.status.in-stock {
  background: rgba(16, 185, 129, 0.12);
  color: #047857;
}

.status.low-stock {
  background: rgba(245, 158, 11, 0.12);
  color: #b45309;
}

.status.limited {
  background: rgba(168, 85, 247, 0.12);
  color: #7c3aed;
}

.footer {
  background: #171b20;
  color: rgba(255, 255, 255, 0.8);
  padding: 40px 0 42px;
  margin-top: 28px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 30px;
}

.footer-brand {
  color: white;
}

.footer h3 {
  font-size: 1.7rem;
  margin-bottom: 12px;
}

@media (max-width: 980px) {
  .hero-grid,
  .about-grid,
  .product-grid,
  .review-grid,
  .footer-grid,
  .admin-grid {
    grid-template-columns: 1fr 1fr;
  }

  .hero-grid,
  .about-grid {
    grid-template-columns: 1fr;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .nav {
    flex-wrap: wrap;
    justify-content: center;
    padding: 18px 0;
  }

  .nav-links {
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero {
    padding-top: 40px;
  }

  .stats-grid,
  .product-grid,
  .review-grid,
  .admin-grid,
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .toolbar {
    align-items: stretch;
  }

  .search-box {
    width: 100%;
  }

  .large-card img {
    height: 480px;
  }
}
